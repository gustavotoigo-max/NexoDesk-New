<UserControl x:Class="NexoDesk.App.Controls.ImageFitOptions"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             MinWidth="260">
    <StackPanel>
        <CheckBox Style="{DynamicResource Nx.Check}" Content="Melhorar nitidez ao ajustar à janela"
                  IsChecked="{Binding EnhancedWindowFit}" />
        <Grid Margin="0,12,0,0" IsEnabled="{Binding EnhancedWindowFit}">
            <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="54" /></Grid.ColumnDefinitions>
            <Slider x:Name="SharpnessSlider" Minimum="0" Maximum="100" TickFrequency="1" IsSnapToTickEnabled="True"
                    SmallChange="1" LargeChange="10" VerticalAlignment="Center"
                    Value="{Binding SharpnessPercent, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                    AutomationProperties.Name="Intensidade da nitidez" />
            <TextBlock Grid.Column="1" Text="{Binding SharpnessPercent, StringFormat={}{0}%}" HorizontalAlignment="Right"
                       VerticalAlignment="Center" Foreground="{DynamicResource Nx.Text}" FontWeight="SemiBold" />
        </Grid>
        <TextBlock Style="{DynamicResource Nx.Hint}" TextWrapping="Wrap"
                   Text="0% sem reforço · 100% intensidade máxima. Ajuste até as letras ficarem confortáveis; excesso pode criar contornos." />
        <Button Style="{DynamicResource Nx.Button.Small}" Content="Restaurar padrão (35%)" Command="{Binding ResetCommand}"
                HorizontalAlignment="Left" Margin="0,10,0,0" />
    </StackPanel>
</UserControl>
