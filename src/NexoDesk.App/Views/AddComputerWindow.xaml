<ui:NxWindow x:Class="NexoDesk.App.Views.AddComputerWindow"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="clr-namespace:NexoDesk.Ui.Controls;assembly=NexoDesk.Ui"
             Title="Adicionar PC REMOTO" Width="660" SizeToContent="Height"
             ResizeMode="NoResize" CanMinimize="False" CanMaximize="False" ShowFooter="False"
             ShowInTaskbar="False" WindowStartupLocation="CenterOwner"
             MaxHeight="{Binding Source={x:Static SystemParameters.WorkArea}, Path=Height}">
    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <StackPanel Margin="28,24">
            <TextBlock Style="{DynamicResource Nx.PageTitle}" Text="Adicionar PC REMOTO" />
            <TextBlock Style="{DynamicResource Nx.PageSubtitle}" Margin="0,8,0,24"
                       Text="No PC REMOTO, clique em Gerar código de acesso. Depois cole o código completo abaixo." />
            <TextBlock Style="{DynamicResource Nx.FieldLabel}" Text="Código de acesso" Margin="0,0,0,8" />
            <TextBox x:Name="AddressBox" Style="{DynamicResource Nx.Input.Mono}" FontSize="14"
                     Text="{Binding AccessCode, UpdateSourceTrigger=PropertyChanged}" TextWrapping="Wrap"
                     MinHeight="92" MaxHeight="160" Padding="12,10" AcceptsReturn="False" VerticalContentAlignment="Top"
                     VerticalScrollBarVisibility="Auto" />
            <TextBlock Style="{DynamicResource Nx.Hint}" Text="Começa com NXD1- e já inclui o endereço. Vale 10 minutos e uma única vez." />
            <TextBlock Style="{DynamicResource Nx.FieldLabel}" Text="Nome (opcional)" Margin="0,22,0,8" />
            <TextBox Style="{DynamicResource Nx.Input}" FontSize="15" MinHeight="44"
                     Text="{Binding Name, UpdateSourceTrigger=PropertyChanged}" MaxLength="64" />
            <TextBlock Style="{DynamicResource Nx.Hint}" Text="Em branco, usa o nome informado pelo PC REMOTO." />
            <ProgressBar Margin="0,20,0,0" IsIndeterminate="True"
                         Style="{DynamicResource Nx.Progress}"
                         Visibility="{Binding IsBusy, Converter={StaticResource BoolToVisibility}}" />
            <TextBlock Style="{DynamicResource Nx.ProgressStatus}" Text="{Binding StatusText}" Tag="{Binding StatusTag}" />
            <Border Style="{DynamicResource Nx.Section}" Margin="0,22,0,0">
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button Style="{DynamicResource Nx.Button}" Content="{Binding CancelText}" Command="{Binding CancelCommand}"
                            IsCancel="True" Margin="0,0,10,0" />
                    <Button Style="{DynamicResource Nx.Button.Primary}" Content="Parear" Command="{Binding PairCommand}" IsDefault="True" />
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</ui:NxWindow>
