<ui:NxWindow x:Class="NexoDesk.App.Views.SessionWindow"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:ui="clr-namespace:NexoDesk.Ui.Controls;assembly=NexoDesk.Ui"
             xmlns:vm="clr-namespace:NexoDesk.App.ViewModels"
             xmlns:appControls="clr-namespace:NexoDesk.App.Controls"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance Type=vm:SessionViewModel}"
             Title="{Binding Title}"
             Tagline="{Binding Tagline}"
             Width="1280" Height="800" MinWidth="640" MinHeight="420"
             WindowStartupLocation="CenterScreen" WindowState="Maximized" ShowTitleBar="False" ShowFooter="False">
    <WindowChrome.WindowChrome>
        <!-- Sem faixa de caption invisível sobre os primeiros pixels remotos. Maximização normal preserva a barra do Windows. -->
        <WindowChrome CaptionHeight="0" ResizeBorderThickness="6" GlassFrameThickness="0" CornerRadius="0" UseAeroCaptionButtons="False" />
    </WindowChrome.WindowChrome>

    <Grid x:Name="SessionCanvas" Background="#05070C" ClipToBounds="True">
        <Grid.Resources>
            <Style x:Key="OverlayButton" TargetType="Button">
                <Setter Property="Foreground" Value="White" /><Setter Property="Background" Value="#86101D31" />
                <Setter Property="FontSize" Value="12" /><Setter Property="Padding" Value="9,7" /><Setter Property="Margin" Value="2" />
                <Setter Property="Focusable" Value="False" /><Setter Property="Cursor" Value="Hand" />
                <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button">
                    <Border x:Name="ButtonBorder" Background="{TemplateBinding Background}" CornerRadius="4" Padding="{TemplateBinding Padding}">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="ButtonBorder" Property="Background" Value="#F01E3554" /></Trigger>
                        <Trigger Property="IsPressed" Value="True"><Setter TargetName="ButtonBorder" Property="Background" Value="#FF2860A0" /></Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate></Setter.Value></Setter>
            </Style>
            <Style x:Key="OverlayToggle" TargetType="ToggleButton">
                <Setter Property="Foreground" Value="White" /><Setter Property="Background" Value="#86101D31" />
                <Setter Property="FontSize" Value="12" /><Setter Property="Padding" Value="9,7" /><Setter Property="Margin" Value="2" />
                <Setter Property="Focusable" Value="False" /><Setter Property="Cursor" Value="Hand" />
                <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ToggleButton">
                    <Border x:Name="ButtonBorder" Background="{TemplateBinding Background}" CornerRadius="4" Padding="{TemplateBinding Padding}">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsChecked" Value="True"><Setter TargetName="ButtonBorder" Property="Background" Value="#C02860A0" /></Trigger>
                        <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="ButtonBorder" Property="Background" Value="#F01E3554" /></Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate></Setter.Value></Setter>
            </Style>
        </Grid.Resources>
        <!-- Vídeo remoto: ajustado à área útil, sem distorção -->
        <ScrollViewer x:Name="VideoScroll" Focusable="False" HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Disabled"
                      HorizontalContentAlignment="Stretch" VerticalContentAlignment="Stretch" ScrollChanged="OnVideoScroll">
            <appControls:AdaptiveDesktopImage x:Name="RemoteImage" Source="{Binding Frame}" EnhancedFit="{Binding ImageFit.EnhancedWindowFit}" SharpnessPercent="{Binding ImageFit.SharpnessPercent}"
                                             SnapsToDevicePixels="True" UseLayoutRounding="True" Focusable="True" />
        </ScrollViewer>

        <Grid x:Name="ControlsOverlay" Panel.ZIndex="20" HorizontalAlignment="Center" VerticalAlignment="Top" Margin="6,4,6,0"
              MouseEnter="OnControlsEnter" MouseLeave="OnControlsLeave">
            <Border x:Name="ExpandedControls" Background="#50081020" CornerRadius="4" Padding="3">
                <WrapPanel MaxWidth="780" VerticalAlignment="Top">
                    <TextBlock Text="⠿" Foreground="White" Padding="6" Cursor="SizeAll" VerticalAlignment="Center"
                               ToolTip="Arrastar janela; duplo clique maximiza/restaura" MouseLeftButtonDown="OnDragSession" />
                    <TextBlock Text="{Binding Title}" Foreground="White" MaxWidth="100" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" Margin="2,0,6,0" />
                    <ToggleButton x:Name="ActualScale" Style="{StaticResource OverlayToggle}" Content="100%" IsChecked="True"
                                  ToolTip="Pixels originais, sem filtros. Desmarque para ajustar à janela." Click="OnToggleScale" />
                    <Button x:Name="SharpnessButton" Style="{StaticResource OverlayButton}" Content="Nitidez" Click="OnOpenSharpness" ToolTip="Ajustar nitidez da imagem reduzida" />
                    <Button x:Name="InfoButton" Style="{StaticResource OverlayButton}" Content="Info" Click="OnOpenInfo" ToolTip="Informações da conexão" />
                    <Button Style="{StaticResource OverlayButton}" Content="Principal" Click="OnShowMain" ToolTip="Abrir a janela principal e informações das sessões" />
                    <Button Style="{StaticResource OverlayButton}" Content="Tela cheia" Click="OnToggleFullScreen" ToolTip="Alternar tela cheia (Ctrl+Alt+F11)" />
                    <Button Style="{StaticResource OverlayButton}" Content="—" Click="OnMinimizeSession" ToolTip="Minimizar acesso" />
                    <Button Style="{StaticResource OverlayButton}" Content="□" Click="OnMaximizeSession" ToolTip="Maximizar/restaurar sem ocultar a barra do Windows" />
                    <Button Style="{StaticResource OverlayButton}" Content="×" Click="OnCloseSession" ToolTip="Fechar e desconectar este acesso" />
                    <Button Style="{StaticResource OverlayButton}" Content="▴" Click="OnHideControls" ToolTip="Recolher controles" />
                </WrapPanel>
            </Border>
            <Button x:Name="CollapsedControls" Style="{StaticResource OverlayButton}" Content="NexoDesk ▾" Visibility="Collapsed"
                    Click="OnShowControls" ToolTip="Mostrar controles do acesso (Ctrl+Alt+Home)" />
        </Grid>
            <Popup x:Name="SharpnessPopup" PlacementTarget="{Binding ElementName=SharpnessButton}" Placement="Bottom"
                   StaysOpen="False" AllowsTransparency="True" Closed="OnSharpnessClosed" PreviewKeyDown="OnSharpnessKeyDown">
                <Border Background="{DynamicResource Nx.Surface}" BorderBrush="{DynamicResource Nx.Border}" BorderThickness="1"
                        CornerRadius="4" Padding="18" Width="350" Margin="0,6,0,0">
                    <StackPanel>
                        <TextBlock Text="NITIDEZ EM JANELA" Style="{DynamicResource Nx.SectionLabel}" />
                        <appControls:ImageFitOptions x:Name="SharpnessOptions" />
                        <TextBlock Style="{DynamicResource Nx.Hint}" Text="Apenas a visualização local muda. O botão 100% da barra mostra os pixels em tamanho real, sem filtros." />
                        <Button Style="{DynamicResource Nx.Button.Small}" Content="Concluir" Click="OnCloseSharpness"
                                HorizontalAlignment="Right" Margin="0,12,0,0" />
                    </StackPanel>
                </Border>
            </Popup>
        <Popup x:Name="InfoPopup" PlacementTarget="{Binding ElementName=InfoButton}" Placement="Bottom" StaysOpen="False"
               AllowsTransparency="True" Closed="OnInfoClosed" PreviewKeyDown="OnInfoKeyDown">
            <Border Background="{DynamicResource Nx.Surface}" BorderBrush="{DynamicResource Nx.Border}" BorderThickness="1" CornerRadius="4" Width="360" Padding="18" Margin="0,6,0,0">
                <StackPanel>
                    <TextBlock Text="{Binding ServerName}" FontSize="16" FontWeight="SemiBold" Foreground="{DynamicResource Nx.Text}" />
                    <TextBlock Text="{Binding ControlStatus}" Style="{DynamicResource Nx.Hint}" />
                    <TextBlock Text="{Binding ConnectionDetail}" Style="{DynamicResource Nx.Hint}" />
                    <TextBlock Text="{Binding DisplayText}" Style="{DynamicResource Nx.Hint}" />
                    <TextBlock Text="{Binding FitStatus, ElementName=RemoteImage}" Style="{DynamicResource Nx.Hint}" />
                    <CheckBox x:Name="AutomaticPan" Style="{DynamicResource Nx.Check}" Content="Mover imagem nas bordas (100%)"
                              IsChecked="True" Click="OnAutomaticPanChanged" Margin="0,12,0,0" />
                    <TextBlock Style="{DynamicResource Nx.Hint}" Text="Mantém os pixels originais. Aproxime o mouse da borda para ver o topo ou a base. Desmarque para usar barras de rolagem." />
                    <Button x:Name="InfoCloseButton" Content="Concluir" Style="{DynamicResource Nx.Button.Small}" HorizontalAlignment="Right" Margin="0,12,0,0" Click="OnCloseInfo" />
                </StackPanel>
            </Border>
        </Popup>
        <!-- Ponteiro do PC REMOTO: desenhado por cima da imagem, posicionado no código. -->
        <Canvas x:Name="CursorLayer" IsHitTestVisible="False">
            <Path x:Name="CursorArrow" Visibility="Collapsed"
                  Data="M0,0 L0,16 L4,12 L7,19 L9.5,18 L6.5,11 L11,11 Z"
                  Fill="White" Stroke="#101317" StrokeThickness="1" StrokeLineJoin="Round">
                <Path.Effect>
                    <DropShadowEffect Color="#000000" BlurRadius="3" ShadowDepth="0" Opacity="0.6" />
                </Path.Effect>
            </Path>
        </Canvas>

        <!-- Conectado, ainda sem vídeo -->
        <Border HorizontalAlignment="Center" VerticalAlignment="Center" MaxWidth="520" Padding="28,26">
            <Border.Style>
                <Style TargetType="Border" BasedOn="{StaticResource Nx.Card}">
                    <Setter Property="Visibility" Value="Collapsed" />
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding ShowWaiting}" Value="True">
                            <Setter Property="Visibility" Value="Visible" />
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </Border.Style>
            <StackPanel>
                <Border Width="44" Height="44" CornerRadius="22" Background="{DynamicResource Nx.SuccessSoft}" HorizontalAlignment="Center" Margin="0,0,0,12">
                    <TextBlock FontFamily="{DynamicResource Nx.Icons}" Text="&#xE72E;" FontSize="18" Foreground="{DynamicResource Nx.Success}"
                               HorizontalAlignment="Center" VerticalAlignment="Center" />
                </Border>
                <TextBlock HorizontalAlignment="Center" FontSize="16" FontWeight="SemiBold">
                    <Run Text="Conexão segura com" /> <Run Text="{Binding ServerName, Mode=OneWay}" />
                </TextBlock>
                <TextBlock Style="{DynamicResource Nx.Muted}" TextAlignment="Center" Margin="0,6,0,18"
                           Text="Conectado. Aguardando a primeira imagem do desktop remoto." />
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="120" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="26" />
                        <RowDefinition Height="26" />
                        <RowDefinition Height="26" />
                        <RowDefinition Height="26" />
                    </Grid.RowDefinitions>
                    <TextBlock Style="{DynamicResource Nx.FieldLabel}" Text="PC REMOTO" />
                    <TextBlock Grid.Column="1" VerticalAlignment="Center" Text="{Binding ServerId}" FontFamily="{DynamicResource Nx.Mono}" FontSize="12" />
                    <TextBlock Grid.Row="1" Style="{DynamicResource Nx.FieldLabel}" Text="Certificado" />
                    <TextBlock Grid.Row="1" Grid.Column="1" VerticalAlignment="Center" FontFamily="{DynamicResource Nx.Mono}" FontSize="12">
                        <Run Text="{Binding Fingerprint, Mode=OneWay}" /><Run Text="… (conferido)" Foreground="{DynamicResource Nx.SuccessText}" />
                    </TextBlock>
                    <TextBlock Grid.Row="2" Style="{DynamicResource Nx.FieldLabel}" Text="Canal" />
                    <TextBlock Grid.Row="2" Grid.Column="1" VerticalAlignment="Center" Text="{Binding Protocol}" />
                    <TextBlock Grid.Row="3" Style="{DynamicResource Nx.FieldLabel}" Text="Tela remota" />
                    <TextBlock Grid.Row="3" Grid.Column="1" VerticalAlignment="Center" Text="{Binding DisplayText}" />
                </Grid>
            </StackPanel>
        </Border>

        <!-- Sessão encerrada -->
        <Border HorizontalAlignment="Center" VerticalAlignment="Center" MaxWidth="480" Padding="28,26">
            <Border.Style>
                <Style TargetType="Border" BasedOn="{StaticResource Nx.Card}">
                    <Setter Property="Visibility" Value="Collapsed" />
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding IsEnded}" Value="True">
                            <Setter Property="Visibility" Value="Visible" />
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </Border.Style>
            <StackPanel>
                <Border Width="44" Height="44" CornerRadius="22" Background="{DynamicResource Nx.WarningSoft}" HorizontalAlignment="Center" Margin="0,0,0,12">
                    <TextBlock FontFamily="{DynamicResource Nx.Icons}" Text="&#xE7BA;" FontSize="18" Foreground="{DynamicResource Nx.Warning}"
                               HorizontalAlignment="Center" VerticalAlignment="Center" />
                </Border>
                <TextBlock HorizontalAlignment="Center" FontSize="16" FontWeight="SemiBold" Text="Sessão encerrada" />
                <TextBlock Style="{DynamicResource Nx.Muted}" TextAlignment="Center" Margin="0,6,0,20" Text="{Binding EndReason}" />
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                    <Button Style="{DynamicResource Nx.Button}" Content="Fechar" Command="{Binding CloseCommand}" Margin="0,0,10,0" />
                    <Button Style="{DynamicResource Nx.Button.Primary}" Content="Reconectar" Command="{Binding ReconnectCommand}" />
                </StackPanel>
            </StackPanel>
        </Border>
    </Grid>
</ui:NxWindow>
